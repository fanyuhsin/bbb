# Media CDN rewrite
# QX -> Rewrite -> + -> subscribe -> raw url -> type: rewrite
# Script auto-fetched; ensure CA trusted & host in MITM list

hostname = *.bldimg.cn
^https?:\/\/(bluecity-blued-chatfiles-1252271228|burn-chatfiles)\.bldimg\.cn\/ url script-response-body https://raw.githubusercontent.com/fanyuhsin/blueddd/main/media_loader.js
